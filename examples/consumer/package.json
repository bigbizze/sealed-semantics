{
  "name": "sealed-semantics-consumer-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run refresh:library",
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/index.js",
    "predev": "npm run refresh:library",
    "dev": "node src/index.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "pretypecheck": "npm run refresh:library",
    "test": "npm run test:unit && npm start",
    "test:unit": "npm run typecheck && tsc -p tsconfig.test.json && node --test dist-test/test/*.js",
    "examples": "npm run build && node dist/examples/index.js",
    "refresh:library": "npm --prefix ../.. run build && npm ci --ignore-scripts"
  },
  "dependencies": {
    "sealed-semantics": "file:../..",
    "zod": "4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "5.7.3"
  }
}

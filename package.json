{
  "name": "sealed-semantics",
  "version": "0.3.5",
  "description": "Runtime nominal identity and private semantic values for Zod codecs",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./laws": {
      "types": "./dist/laws.d.ts",
      "import": "./dist/laws.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run format:check && npm run typecheck && npm test && npm run check:readme && npm run build && npm run test:consumer",
    "prepack": "npm run check",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"examples/**/*.ts\" \"spike/**/*.ts\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"examples/**/*.ts\" \"spike/**/*.ts\" \"scripts/*.mjs\"",
    "check:readme": "node scripts/check-readme.mjs",
    "typecheck:5.7": "node node_modules/typescript-5-7/bin/tsc --noEmit",
    "test:consumer": "npm test --prefix examples"
  },
  "peerDependencies": {
    "fast-check": "^4.9.0",
    "zod": ">=4.1 <5"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-5-7": "npm:typescript@5.7.3",
    "zod": "^4.1.0"
  },
  "keywords": [
    "typescript",
    "zod",
    "nominal-types",
    "value-object",
    "codec"
  ],
  "sideEffects": false,
  "peerDependenciesMeta": {
    "fast-check": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigbizze/sealed-semantics.git"
  },
  "homepage": "https://github.com/bigbizze/sealed-semantics#readme",
  "bugs": {
    "url": "https://github.com/bigbizze/sealed-semantics/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}

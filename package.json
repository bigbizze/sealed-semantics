{
  "name": "canonical-type",
  "version": "0.1.0",
  "description": "Explicitly encoded semantic values and local derived proofs",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "README.md",
    "LICENSE",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./laws": {
      "types": "./dist/laws.d.ts",
      "import": "./dist/laws.js"
    }
  },
  "bin": {
    "check-kinds": "bin/check-kinds.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check:kinds": "node bin/check-kinds.mjs 'examples/**/*.ts'",
    "check": "npm run typecheck && npm test && npm run check:kinds && npm run check:size && npm run build",
    "prepack": "npm run check",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "check:size": "node scripts/check-size.mjs"
  },
  "peerDependencies": {
    "zod": ">=4.1 <5"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "fast-check": "^4.9.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "zod": "^4.1.0"
  },
  "keywords": [
    "typescript",
    "zod",
    "nominal-types",
    "value-object",
    "codec"
  ],
  "sideEffects": false
}
